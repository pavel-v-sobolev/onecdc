# Лабораторный контур: демо УТ на виртуалке разработчика.
#
# Файл ЛЕЖИТ В РЕПОЗИТОРИИ намеренно — это не секреты, а описание стенда: адрес в host-only сети
# VirtualBox (192.168.56.0/24 доступна только с этой машины) и учётные данные демо-базы. Держим
# его в git, чтобы настройки стенда не терялись и не расходились между отладочными скриптами.
#
# Боевым значениям здесь не место. Свой контур — не правкой этого файла, а соседним
# trade_demo1.local.env (он в .gitignore) или переменными окружения: и то, и другое перекрывает
# записанное здесь.
#
# Применяется тремя способами:
#   отладочные скрипты читают сам                python tests/debug_trade.py
#   одной командой                               uv run --env-file tests/trade_demo1.env pytest -m integration
#   в текущей оболочке                           set -a; . tests/trade_demo1.env; set +a

ONECDC_ODATA_URL=http://192.168.56.101/trade_demo/odata/standard.odata
ONECDC_ODATA_USER=админ
ONECDC_ODATA_PASSWORD=секрет
ONECDC_EXCHANGE_NAME=ДляODATA
ONECDC_QUEUE_GUID=a9bc23c5-3689-11f1-926c-0800270bc6cb
ONECDC_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/onecdc
ONECDC_DB_SCHEMA=onecdc_trade_demo
