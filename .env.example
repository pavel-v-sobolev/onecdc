# Значения для docker compose: скопируйте в .env рядом (он в .gitignore) и заполните.
#   cp .env.example .env
#
# Тот же файл читает и сам compose, и `uv run --env-file .env …`. Лабораторные стенды для отладки
# описаны отдельно — tests/<контур>.env, они лежат в репозитории (см. tests/debug_config.py).

# --- обязательные ---
ONECDC_ODATA_URL=http://server/base/odata/standard.odata
ONECDC_EXCHANGE_NAME=ДляODATA
ONECDC_QUEUE_GUID=
ONECDC_DB_URL=postgresql+psycopg2://user:pass@dbhost:5432/dwh

# --- авторизация 1С; пусто — публикация без авторизации ---
ONECDC_ODATA_USER=
ONECDC_ODATA_PASSWORD=

# --- необязательные (значения по умолчанию — в README_ENV.md) ---
ONECDC_DB_SCHEMA=
ONECDC_DB_TEMP_SCHEMA=
ONECDC_FULL_LOAD_WORKERS=2
ONECDC_POLL_INTERVAL=60
ONECDC_LOG_LEVEL=INFO
ONECDC_LOG_RETENTION_DAYS=30
